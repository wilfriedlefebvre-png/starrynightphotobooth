{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/about/",
      "destination": "/about/index.html"
    },
    {
      "source": "/weddings",
      "destination": "/weddings/index.html"
    },
    {
      "source": "/weddings/",
      "destination": "/weddings/index.html"
    },
    {
      "source": "/company-events",
      "destination": "/company-events/index.html"
    },
    {
      "source": "/company-events/",
      "destination": "/company-events/index.html"
    },
    {
      "source": "/private-parties",
      "destination": "/private-parties/index.html"
    },
    {
      "source": "/private-parties/",
      "destination": "/private-parties/index.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery/index.html"
    },
    {
      "source": "/gallery/",
      "destination": "/gallery/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/contact/",
      "destination": "/contact/index.html"
    }
  ]
}
